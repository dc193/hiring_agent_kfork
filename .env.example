# Anthropic API Key (required for resume parsing)
ANTHROPIC_API_KEY=your-api-key-here

# Database URL (for Vercel Postgres)
# DATABASE_URL=postgres://...

# CS Account Authentication (RSA Public Key for JWT verification)
# Get the public key from CS Account admin
# Keep the entire key including -----BEGIN PUBLIC KEY----- and -----END PUBLIC KEY-----
# Use \n for newlines in single-line format:
# CS_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBI...\n-----END PUBLIC KEY-----"
CS_AUTH_PUBLIC_KEY=
